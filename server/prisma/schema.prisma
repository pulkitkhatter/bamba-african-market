// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Model names are prefixed "Market" so these tables don't collide with the
// Z Halal Restaurant project's tables (Admin, SiteSettings, MenuItem, ...) --
// both sites share the same Supabase Postgres database (same owner, one
// Supabase project) but each project owns its own distinctly-named tables.
// Schema changes are applied via raw SQL (`prisma db execute --file
// prisma/manual_*.sql`), never `prisma db push`/`migrate` -- those diff the
// WHOLE database against this schema file and would try to drop the
// restaurant's tables since they aren't declared here.

model MarketAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model MarketSettings {
  id                Int      @id @default(1)
  tagline           String   @default("Fresh. Authentic. African.")
  usp               String   @default("West African specialty grocery, fresh halal meat, and hard-to-find African imports.")
  heroImageUrl      String?
  comingSoonMessage String   @default("Hi! I'd like to place an online order — is that available yet?")
  showReviewsWidget Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model MarketCategory {
  id              String   @id @default(uuid())
  name            String
  description     String?
  photoUrl        String?
  highlightItems  String[] @default([])
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// `category` is a plain string matching a MarketCategory.name, not a foreign
// key -- mirrors the restaurant project's denormalized MenuItem.category
// pattern (simpler than a relation, and the category list rarely changes).
model MarketProduct {
  id          String   @id @default(uuid())
  name        String
  category    String
  description String?
  price       Float
  photoUrl    String?
  inStock     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum MarketFulfillmentType {
  DELIVERY
  PICKUP
}

model MarketOrder {
  id              String                @id @default(uuid())
  customerName    String
  phone           String
  fulfillmentType MarketFulfillmentType
  address         String?
  notes           String?
  completed       Boolean               @default(false)
  items           MarketOrderItem[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model MarketOrderItem {
  id          String      @id @default(uuid())
  orderId     String
  order       MarketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName String
  quantity    Int
  unitPrice   Float
}
